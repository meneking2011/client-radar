{
  "manifest_version": 3,
  "name": "ClientRadar Capture",
  "version": "1.1.0",
  "description": "Time-limited Facebook search discovery for an authorised account.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://m.facebook.com/*",
    "https://clientradar-fxrsau.v2.appdeploy.ai/*"
  ],
  "action": {
    "default_title": "ClientRadar Discovery",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/search/*",
        "https://m.facebook.com/search/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}